{"nodes": [{"id": "readme_cloud_ecommerce", "label": "Cloud E-commerce Platform", "file_type": "concept", "source_file": "README.md", "source_location": "L1-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-stack e-commerce demo: Next.js storefront + Spring Boot API behind Nginx, orchestrated by Docker Compose. Chosen so the whole stack runs from a single `docker compose up --build` with one public entrypoint."}, {"id": "readme_nginx_reverse_proxy", "label": "Nginx Reverse Proxy (:80/:443)", "file_type": "concept", "source_file": "README.md", "source_location": "L8-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single ingress: `/` routes to the frontend and `/api/` rewrites to the backend, so the browser only ever talks to one origin (avoids CORS and exposes one TLS cert)."}, {"id": "readme_spring_boot_backend", "label": "Spring Boot 4 Backend (:8080)", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nextjs_frontend", "label": "Next.js 16 Storefront (:3000)", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_postgres_database", "label": "PostgreSQL 16 Database", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jwt_authentication", "label": "JWT Authentication & Admin Seeding", "file_type": "concept", "source_file": "README.md", "source_location": "L39-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT with role support plus an auto-seeded admin user (EMAIL_ADMIN / PASSWORD_ADMIN) so a fresh deployment always has an admin able to manage products."}, {"id": "readme_cart_persistence", "label": "Server-side Cart Persistence & Cleanup", "file_type": "concept", "source_file": "README.md", "source_location": "L39-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cart lives server-side (not in localStorage) so it survives device switches; a scheduled job cleans up abandoned carts to keep the table bounded."}, {"id": "readme_region_based_shipping", "label": "Region-based Shipping Quotes", "file_type": "concept", "source_file": "README.md", "source_location": "L39-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat rates per Brazilian macro-region resolved from the CEP \u2014 avoids integrating a live carrier API while still producing plausible shipping costs."}, {"id": "readme_mercado_pago_checkout", "label": "Mercado Pago Checkout & Webhook", "file_type": "concept", "source_file": "README.md", "source_location": "L39-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_s3_image_storage", "label": "AWS S3 Product Image Storage", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mp_webhook_secret", "label": "MP_WEBHOOK_SECRET (webhook signature verification)", "file_type": "concept", "source_file": "README.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signing secret used to verify POST /order/webhook. Blank => signature check is skipped with a warning, so local/demo runs work without a secret; required in prod for real payments."}, {"id": "readme_app_base_url", "label": "APP_BASE_URL (public HTTPS base)", "file_type": "concept", "source_file": "README.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationa