{"nodes": [{"id": "api_readme_ecommerce_api", "label": "E-commerce REST API", "file_type": "document", "source_file": "API/README.md", "source_location": "L1-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend handling users, products, categories, carts and payments, explicitly optimized for performance, resilience and fault tolerance."}, {"id": "api_readme_layered_architecture", "label": "Controller / Service / Repository Layering", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L14-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic three-tier split: Controller = HTTP, Service = business rules, Repository = data access. Keeps business rules testable independently of the web layer."}, {"id": "api_readme_jwt_auth", "label": "JWT Auth with Refresh Token Strategy", "file_type": "concept", "source_file": "API/README.md", "source_location": "L23-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-lived JWT with expiration plus a refresh token, so a leaked access token has a bounded blast radius."}, {"id": "api_readme_rbac", "label": "Role-Based Access Control (RBAC)", "file_type": "concept", "source_file": "API/README.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoints are tiered Public / JWT / Admin; write operations on products and categories are ADMIN-only while cart and order endpoints only need any authenticated user."}, {"id": "api_readme_bcrypt_hashing", "label": "BCrypt Password Hashing", "file_type": "concept", "source_file": "API/README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords are hashed with BCrypt before persistence so a DB dump never exposes plaintext credentials."}, {"id": "api_readme_n_plus_1_avoidance", "label": "N+1 Query Avoidance via JPA Fetch Strategies", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L19-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JPA fetch strategies and explicit joins are used instead of lazy per-row loading, because listing endpoints would otherwise fan out one query per product/image row."}, {"id": "api_readme_pagination", "label": "Pagination on Listing Endpoints", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring Pageable params (page/size/sort) on GET /product and GET /order to prevent unbounded payloads."}, {"id": "api_readme_s3_object_storage", "label": "S3 Object Storage for Product Images", "file_type": "concept", "source_file": "API/README.md", "source_location": "L29-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images are offloaded to S3 rather than the DB/filesystem so the API stays stateless and containers remain disposable."}, {"id": "api_readme_iam_least_privilege", "label": "Dedicated IAM User (Least Privilege)", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated IAM user restricted to only the required S3 resources, so leaked AWS credentials cannot touch anything else in the account. Sensitive values come from .env, never source."}, {"id": "api_readme_cart_consistency_handling", "label": "Cart Consistency Handling", "file_type": "concept", "source_file": "API/README.md", "source_location": "L104-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planned in CartService#getOrCreateCart: detect products that became unavailable while the cart sat idle and surface that to the UI, rather than failing at checkout."}, {"id": "api_readme_mercado_pago_integration", "label": "Mercado Pago Integration (checkout + webhook)", "file_type": "concept", "source_file": "API/README.md", "source_location": "L82-L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /order/{userId} creates a checkout and returns the MP URL; POST /order/webhook is public because Mercado Pago calls it server-to-server."}, {"id": "api_readme_redis_caching_future", "label": "Planned Redis Caching Layer", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listed as a future improvement to improve read performance; not yet implemented."}, {"id": "api_readme_kafka_event_driven_future", "label": "Planned Event-Driven Architecture (Kafka)", "file_type": "rationale", "source_file": "API/README.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listed as a future improvement for scalability; the current design is synchronous request/response."}], "edges": [{"source": "api_readme_ecommerce_api", "target": "api_readme_layered_architecture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "API/README.md", "source_location": "L14-L17", "weight": 1.0}, {"source": "api_readme_ecommerce_api", "target": "api_readme_jwt_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "API/README.md", "source_location": "L23-L26", "weight": 1.0}, {"source": "api_readme_jwt_auth", "target": "api_readme_rbac", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "API/README.md", "source_location": "L25-L26", "weight": 1.0}, {"source": "api_readme_jwt_auth", "target": "api_readme_bcrypt_hashing", "relation": "conceptuall