{"nodes": [{"id": "front_end_claude_storefront_architecture", "label": "Next.js App Router Storefront Architecture", "file_type": "document", "source_file": "front-end/CLAUDE.md", "source_location": "L15-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "front_end_claude_server_component_data_flow", "label": "Server-Component Fetch / Client-Component Interactivity", "file_type": "rationale", "source_file": "front-end/CLAUDE.md", "source_location": "L33-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server Components in app/ fetch data (axios or fetch with next: { revalidate }) and pass it as props into \"use client\" components, which own interactivity, cart operations and auth-gated content. Keeps data fetching off the client bundle."}, {"id": "front_end_claude_authcontext", "label": "AuthContext (JWT auth state)", "file_type": "code", "source_file": "front-end/CLAUDE.md", "source_location": "L37-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On mount reads localStorage token, sets api.defaults.headers.common['Authorization'], then calls GET /users/me to rehydrate the user. Token in localStorage + a globally-injected axios header means every caller is authenticated without threading the token through props."}, {"id": "front_end_claude_use_cart", "label": "useCart / CartProvider hook", "file_type": "code", "source_file": "front-end/CLAUDE.md", "source_location": "L41-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "front_end_claude_optimistic_updates", "label": "Optimistic Cart Mutations with Rollback", "file_type": "rationale", "source_file": "front-end/CLAUDE.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "addItem/updateQuantity/removeItem/clearCart update local state immediately and roll back on API error, with sonner toasts \u2014 cart state is authoritative server-side but the UI must not wait on a round trip."}, {"id": "front_end_claude_provider_nesting", "label": "Provider Nesting (AuthProvider > CartProvider > Navbar)", "file_type": "rationale", "source_file": "front-end/CLAUDE.md", "source_location": "L45-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CartProvider must nest inside AuthProvider because it needs the user id from AuthContext to fetch GET /cart/:userId. Footer is deliberately rendered outside the providers."}, {"id": "front_end_claude_primitives_layer", "label": "primitives/ Design-System Atoms", "file_type": "concept", "source_file": "front-end/CLAUDE.md", "source_location": "L54-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin wrappers over Radix UI / Vaul (Button, Card, Input, Label, Separator, Sheet, Drawer, Skeleton, Badge, Avatar) \u2014 the atoms that components/ composes into product cards, cart UI and navbar."}, {"id": "front_end_claude_api_service_axios", "label": "services/api.js Axios Instance", "file_type": "code", "source_file": "front-end/CLAUDE.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "front_end_claude_remote_image_sources", "label": "Allowed Remote Image Hosts (next.config.mjs)", "file_type": "concept", "source_file": "front-end/CLAUDE.md", "source_location": "L58-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only images.unsplash.com (demo/seed imagery) and cloud-commerce-stack.s3.sa-east-1.amazonaws.com (real product uploads) are whitelisted for next/image."}], "edges": [{"source": "front_end_claude_storefront_architecture", "target": "readme_nextjs_frontend", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "front-end/CLAUDE.md", "source_location": "L15-L17