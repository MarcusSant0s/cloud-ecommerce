{"nodes": [{"id": "front_end_public_brand_identity_brenda_nunes_brand", "label": "Brenda Nunes Brand Identity System", "file_type": "document", "source_file": "front-end/public/brand-identity.html", "source_location": "L637-L683", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A self-contained brand board (PT-BR) for a semijoias / jewelry brand: cover, logo versions, palette, typography, design system, mockups, developer tokens. Tagline 'Semijoias \u00b7 Eleg\u00e2ncia \u00b7 Exclusividade', dated 2025."}, {"id": "front_end_public_brand_identity_bn_monogram", "label": "BN Monogram (SVG, 3 backgrounds + horizontal + icon)", "file_type": "image", "source_file": "front-end/public/brand-identity.html", "source_location": "L640-L880", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-drawn SVG serif B and N inside a double ring (solid r=44 + dashed r=41). Locked to two strokes only: gold #D4B483 on dark, ink #3A3A3A on light/rose. Shipped in stacked, horizontal (rule-separated) and icon-only lockups so it survives from favicon (16px) to cover (160px)."}, {"id": "front_end_public_brand_identity_color_palette", "label": "Rose / Gold / Off-White Palette", "file_type": "concept", "source_file": "front-end/public/brand-identity.html", "source_location": "L13-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rose #E8C8D2 / rose-deep #D9B0BF / off-white #F7F3F1 / gold #D4B483 / gold-light #E8D5B0 / text #3A3A3A / text-light #8A7F7A / black #1A1A1A. Gold is reserved for accents, labels and hairlines rather than large fills \u2014 it acts as the luxury voltage against a warm off-white canvas."}, {"id": "front_end_public_brand_identity_typography", "label": "Cormorant Garamond + Jost Type System", "file_type": "concept", "source_file": "front-end/public/brand-identity.html", "source_location": "L23-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cormorant Garamond (serif, weights 300-500) for display; Jost (geometric sans, weights 200-400) for body and UI. Everything runs at low weight with heavy uppercase letter-spacing (0.2em-0.35em) to read as editorial luxury rather than SaaS."}, {"id": "front_end_public_brand_identity_design_system_components", "label": "Brand Design System Components", "file_type": "concept", "source_file": "front-end/public/brand-identity.html", "source_location": "L1035-L1200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bot\u00f5es (primary / gold / outline / ghost), Formul\u00e1rios (underline-only inputs that shift the bottom border to gold on focus), Badges, Card de Produto (3:4 rose photo area), Espa\u00e7amentos and Bordas & Raios. Squared corners and borderless underline inputs are the deliberate anti-SaaS signature."}, {"id": "front_end_public_brand_identity_mockups", "label": "Brand Application Mockups", "file_type": "image", "source_file": "front-end/public/brand-identity.html", "source_location": "L1215-L1395", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure-CSS mockups (no images) of packaging box, luxury bag, thank-you card, Instagram profile, product tag and favicon at 16/32/48px \u2014 proving the monogram scales across physical and digital touchpoints."}, {"id": "front_end_public_brand_identity_css_tokens", "label": "CSS Variable Tokens for Developers", "file_type": "concept", "source_file": "front-end/public/brand-identity.html", "source_location": "L1402-L1403", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The :root block (colors, --font-display/--font-body, --space-xs..2xl on a rem scale) is published as the handoff contract so the storefront can consume the brand without re-deriving values."}], "edges": [{"source": "front_end_public_brand_identity_brenda_nunes_brand", "