# Base URL the BROWSER uses to reach the API.
# Local dev: the backend directly. Production: the public origin + /api (nginx
# rewrites /api/* to the backend), injected at image build time as a build-arg,
# not from this file.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Only set inside Docker: base URL for server-side (SSR) calls. The web container
# cannot reach its own public domain, so it talks to the backend service directly.
# INTERNAL_API_URL=http://commerce-api:8080
