# Copy to .env and fill in. Consumed by docker-compose.yml.
# Never commit the real .env — it is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=commerce
DB_USER=postgres
DB_PASSWORD=change-me
# Compose service name; only override when Postgres runs outside the compose network.
DB_HOST=postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 signing key. Must be at least 32 bytes or the app refuses to start.
# Generate one: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-at-least-32-bytes-of-random-data

# Auto-seeded admin account.
EMAIL_ADMIN=admin@example.com
PASSWORD_ADMIN=change-me

# ── Mercado Pago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
# Webhook "assinatura secreta" from the MP dashboard, used to verify POST /order/webhook.
# Blank => the signature check is skipped and a warning is logged. Set it in production.
MP_WEBHOOK_SECRET=

# ── AWS S3 (product images, region sa-east-1) ────────────────────────────────
# These exact names are what the AWS SDK's default credential chain reads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public HTTPS base URL (scheme + host). Drives the MP webhook/back URLs.
APP_BASE_URL=https://your-domain.example

# Seed the demo dataset (products, users, orders) on startup. Idempotent.
APP_SEED_DEMO_DATA=false
# Skip Mercado Pago at checkout and simulate an approved payment. Demos only.
PAYMENTS_DEMO_MODE=false
